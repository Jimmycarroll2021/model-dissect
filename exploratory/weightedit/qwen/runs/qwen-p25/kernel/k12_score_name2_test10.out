def count_element_freq(tup: tuple) -> dict:
    """
    Count the frequency of each element in a mixed nested tuple.
    
    Example:
        count_element_freq((5, 6, (5, 6), 7, (8, 9), 9))
        -> {5: 2, 6: 2, 7: 1, 8: 1, 9: 2}
    """
    result = {}
    
    # Iterate over the tuple elements
    for elem in tup:
        if isinstance(elem, tuple):
            # Recursively count elements in nested tuples
            count = count_element_freq(elem)
        else:
            # Count the element itself
            count = result.get(elem, 0) + 1
        
